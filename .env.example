# konfigurasi source map
GENERATE_SOURCEMAP=false

# jika ingin menambah nama envirement 
# harus dengan nama depan REACT_APP
# ex: REACT_APP_EXAMPLE=example


REACT_APP_TITLE="Lexi Web"
REACT_APP_DESCRIPTION="Cari solusi cepat dan mudah menggunakan Lexi AI, ditenagai oleh teknologi terkini memungkinkan kamu untuk mendapatkan bantuan hukum tanpa kendala biaya dan akses legal!"
REACT_APP_DEBUG=true

REACT_APP_API_URL=https://your-api-base-url
REACT_APP_API_URL_REACT_QUERY=https://your-api-base-url

REACT_APP_APPLE_CLIENT_ID=your-apple-client-id
REACT_APP_APPLE_REDIRECT_URL=https://your-app-url/auth



REACT_APP_GOOGLE_OAUTH_CLIENT_ID_WEB=your-google-oauth-client-id
REACT_APP_GOOGLE_OAUTH_CLIENT_SECRET_WEB=your-google-oauth-client-secret